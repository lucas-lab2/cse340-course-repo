<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Service Connect</title>
  <meta name="description" content="A service project website connecting people with organizations and community opportunities.">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="header-container">
      <a class="logo" href="/">Service Connect</a>

      <nav class="site-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Service Projects</a>
        <a href="/categories">Categories</a>
      </nav>
    </div>
  </header>

  <main>
    <% if (typeof successMessages !== "undefined" && successMessages.length > 0) { %>
      <div class="flash-container" role="status" aria-live="polite">
        <% successMessages.forEach((message) => { %>
          <p class="flash-message flash-success"><%= message %></p>
        <% }) %>
      </div>
    <% } %>

    <% if (typeof errorMessages !== "undefined" && errorMessages.length > 0) { %>
      <div class="flash-container" role="alert">
        <% errorMessages.forEach((message) => { %>
          <p class="flash-message flash-error"><%= message %></p>
        <% }) %>
      </div>
    <% } %>
