<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>
  <p>Explore service project ideas that can bless families, neighborhoods, and communities.</p>
</section>

<section class="section">
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <article class="card project-card">
        <h2><%= project.name %></h2>
        <p><%= project.description %></p>
        <p class="card-meta">Organization: <%= project.organizationName %></p>
      </article>
    <% }) %>
  </div>
</section>

<%- include("partials/footer") %>
