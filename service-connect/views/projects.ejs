<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>
  <p>Explore the next five upcoming service projects and the partner organizations supporting them.</p>
  <% if (isAdmin) { %>
    <div class="page-actions">
      <a class="button" href="/new-project">Create New Service Project</a>
    </div>
  <% } %>
</section>

<section class="section">
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <article class="card project-card">
        <h2>
          <a href="/project/<%= project.projectId %>"><%= project.name %></a>
        </h2>
        <p><%= project.description %></p>
        <p class="card-meta">Date: <%= project.projectDate %></p>
        <p class="card-meta">
          Organization:
          <a href="/organization/<%= project.organizationId %>"><%= project.organizationName %></a>
        </p>
        <div class="card-actions">
          <a class="text-link" href="/project/<%= project.projectId %>">View details</a>
          <% if (isAdmin) { %>
            <a class="text-link" href="/edit-project/<%= project.projectId %>">Edit</a>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<%- include("partials/footer") %>
