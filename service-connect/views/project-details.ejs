<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= project.name %></h1>
  <p><%= project.description %></p>
  <% if (isAdmin) { %>
    <div class="page-actions">
      <a class="button" href="/edit-project/<%= project.projectId %>">Edit Project</a>
      <a class="button button-secondary" href="/project/<%= project.projectId %>/categories">Assign Categories</a>
    </div>
  <% } %>
</section>

<section class="section">
  <article class="list-card">
    <h2>Project Details</h2>
    <p><strong>Date:</strong> <%= project.projectDate %></p>
    <p>
      <strong>Partner Organization:</strong>
      <a href="/organization/<%= project.organizationId %>"><%= project.organizationName %></a>
    </p>
    <p><%= project.description %></p>

    <h3>Categories</h3>
    <% if (categories.length > 0) { %>
      <div class="tag-list" aria-label="Project categories">
        <% categories.forEach((category) => { %>
          <a class="tag" href="/category/<%= category.categoryId %>"><%= category.name %></a>
        <% }) %>
      </div>
    <% } else { %>
      <p>No categories are currently assigned to this project.</p>
    <% } %>

    <% if (currentUser) { %>
      <div class="volunteer-panel">
        <h3>Volunteer Signup</h3>
        <% if (isVolunteering) { %>
          <p class="volunteer-status">You are volunteering for this project.</p>
          <form action="/project/<%= project.projectId %>/volunteer/remove" method="post">
            <button class="button button-secondary" type="submit">Remove Me as Volunteer</button>
          </form>
        <% } else { %>
          <p>Interested in helping with this project?</p>
          <form action="/project/<%= project.projectId %>/volunteer" method="post">
            <button class="button" type="submit">Volunteer for This Project</button>
          </form>
        <% } %>
      </div>
    <% } %>
  </article>
</section>

<%- include("partials/footer") %>
