<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>
  <p>Learn about partner organizations that support service projects and community improvement.</p>
  <div class="page-actions">
    <a class="button" href="/new-organization">Create New Organization</a>
  </div>
</section>

<section class="section">
  <div class="card-grid">
    <% organizations.forEach((organization) => { %>
      <article class="card organization-card">
        <img src="<%= organization.image %>" alt="<%= organization.name %>">
        <div>
          <h2>
            <a href="/organization/<%= organization.organizationId %>"><%= organization.name %></a>
          </h2>
          <p><%= organization.description %></p>
          <div class="card-actions">
            <a class="text-link" href="/organization/<%= organization.organizationId %>">View details</a>
            <a class="text-link" href="/edit-organization/<%= organization.organizationId %>">Edit</a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<%- include("partials/footer") %>
