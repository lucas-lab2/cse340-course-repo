<%- include("partials/header") %>

<section class="page-heading">
  <h1><%= title %></h1>
  <p>Welcome, <%= currentUser.name %>. You are logged in as <strong><%= currentUser.role %></strong>.</p>

  <% if (isAdmin) { %>
    <div class="page-actions">
      <a class="button" href="/users">View Registered Users</a>
      <a class="button button-secondary" href="/new-organization">Create Organization</a>
      <a class="button button-secondary" href="/new-project">Create Project</a>
      <a class="button button-secondary" href="/new-category">Create Category</a>
    </div>
  <% } %>
</section>

<section class="section">
  <div class="card-grid">
    <article class="card">
      <h2>Organizations</h2>
      <p>Browse partner organizations and view their service projects.</p>
      <a class="text-link" href="/organizations">View organizations</a>
    </article>

    <article class="card">
      <h2>Service Projects</h2>
      <p>Review upcoming service opportunities and project details.</p>
      <a class="text-link" href="/projects">View projects</a>
    </article>

    <article class="card">
      <h2>Categories</h2>
      <p>Explore service projects by category.</p>
      <a class="text-link" href="/categories">View categories</a>
    </article>
  </div>
</section>

<section class="section">
  <article class="list-card">
    <h2>My Volunteer Projects</h2>
    <% if (volunteerProjects.length > 0) { %>
      <div class="volunteer-list">
        <% volunteerProjects.forEach((project) => { %>
          <div class="volunteer-item">
            <div>
              <h3><a href="/project/<%= project.projectId %>"><%= project.name %></a></h3>
              <p><%= project.description %></p>
              <p class="item-meta">
                Date: <%= project.projectDate %> | Organization:
                <a href="/organization/<%= project.organizationId %>"><%= project.organizationName %></a>
              </p>
            </div>
            <form action="/project/<%= project.projectId %>/volunteer/remove" method="post">
              <input type="hidden" name="redirectTo" value="/dashboard">
              <button class="button button-secondary" type="submit">Remove</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>You have not signed up to volunteer for any projects yet.</p>
      <a class="text-link" href="/projects">Find a service project</a>
    <% } %>
  </article>
</section>

<%- include("partials/footer") %>
