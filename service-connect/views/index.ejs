<%- include("partials/header") %>

<section class="hero">
  <div class="hero-content">
    <h1><%= title %></h1>
    <p>
      Discover service opportunities, connect with organizations, and make a positive difference in your community.
    </p>
    <a class="button" href="/projects">View Service Projects</a>
  </div>
</section>

<section class="section">
  <h2>Welcome to Service Connect</h2>
  <p>
    This website helps people learn about service organizations, available projects, and different categories of community service.
  </p>

  <div class="card-grid">
    <article class="card">
      <h3>Find Organizations</h3>
      <p>Learn about groups that are working to improve the community.</p>
    </article>

    <article class="card">
      <h3>Explore Projects</h3>
      <p>Review service opportunities that can help people and places around you.</p>
    </article>

    <article class="card">
      <h3>Choose a Category</h3>
      <p>Browse service projects by interest, including education, health, environment, and community support.</p>
    </article>
  </div>
</section>

<%- include("partials/footer") %>
